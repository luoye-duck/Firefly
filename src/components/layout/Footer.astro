        target="_blank"
        href="https://space.bilibili.com/3546655601199620?spm_id_from=333.1007.0.0"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4 fill-current">
